# the-brain (VP) credentials — copy to .env and fill in.
# Trinity injects .env into the agent container (CRED-002). Durable copy lives in
# encrypted `.credentials.enc` (exported via POST /credentials/export; imported on
# agent startup). Prefer updating via Trinity inject+export over hand-editing only
# the live .env (that alone does not survive rebuild).

# Gemini API key — powers the aistudio MCP server (content generation, Google
# Search grounding) and, on Trinity, the Brain Orb voice tile.
GEMINI_API_KEY=your-gemini-api-key

# Optional: where your Obsidian vault lives (defaults to ./Brain in this repo).
VAULT_BASE_PATH=./Brain

# Optional overrides for the ebook-mcp server (EPUB/PDF extraction).
# UV_PATH=uv
# EBOOK_MCP_PATH=/opt/mcp/ebook-mcp

# --- Fleet knowledge graph (resources/fleet-kg) ---
# Read-only Slack bot token for conversations.history across fleet channels.
# Inject via Trinity credentials API, then export to .credentials.enc.
FLEET_KG_SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Trinity HTTP (usually injected by the platform into the agent container)
# TRINITY_BACKEND_URL=http://backend:8000
# TRINITY_MCP_API_KEY=trinity_mcp_...

# GitHub read for scripts/pull-sibling-repos.sh (PAT or per-repo deploy keys)
# GITHUB_PAT=ghp_...
